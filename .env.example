# ====================================================================
# ETHIO ONLINE MARKET (EOM) - PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# Core Application & Security Settings
PORT=3000
NODE_ENV=production
APP_URL="https://your-app-domain.com"
CORS_ORIGIN="https://your-app-domain.com"
JWT_SECRET=your_jwt_secret_min_32_chars_long
DATABASE_URL=postgres://eom_user:password@localhost:5432/eom_db
REQUIRE_POSTGRES=true
WEBHOOK_SECRET=your_eom_webhook_hmac_sha256_secret

# Rate Limiting & File Upload Security Constraints
UPLOAD_LIMIT_MB=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# AI Studio Core Integration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Telebirr SuperApp (Ethio Telecom) API Credentials
# Status: IMPLEMENTED BUT REQUIRES MERCHANT/API CREDENTIALS
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=

# Commercial Bank of Ethiopia (CBE) Merchant API Credentials
# Status: IMPLEMENTED BUT REQUIRES MERCHANT/API CREDENTIALS
CBE_CLIENT_ID=
CBE_CLIENT_SECRET=
CBE_MERCHANT_CODE=

# Bank of Abyssinia (BOA) Merchant API Credentials
# Status: IMPLEMENTED BUT REQUIRES MERCHANT/API CREDENTIALS
BOA_MERCHANT_ID=
BOA_API_KEY=

# Dashen Bank / Amole Merchant API Credentials
# Status: IMPLEMENTED BUT REQUIRES MERCHANT/API CREDENTIALS
DASHEN_MERCHANT_KEY=
DASHEN_SHORT_CODE=

# Awash Bank Merchant API Credentials
# Status: IMPLEMENTED BUT REQUIRES MERCHANT/API CREDENTIALS
AWASH_API_KEY=
AWASH_MERCHANT_ID=

# CBE Birr Mobile Wallet Merchant API Credentials
# Status: IMPLEMENTED BUT REQUIRES MERCHANT/API CREDENTIALS
CBE_BIRR_API_KEY=

# Admin login secret (server-side only; never expose to frontend)
ADMIN_PASSWORD=change-this-in-render
