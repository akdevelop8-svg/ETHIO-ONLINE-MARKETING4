# ====================================================================
# ETHIO ONLINE MARKET (EOM) - PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# Core application settings
PORT=3000
NODE_ENV=production
APP_URL=https://your-frontend-domain.example
CORS_ORIGIN=https://your-frontend-domain.example
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REQUIRE_POSTGRES=true

# Use the Supabase PostgreSQL Session Pooler URI from:
# Supabase Dashboard > Project Settings > Database > Connection string.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend and API use the same Vercel origin; no VITE_API_BASE_URL is needed.

# AI assistant settings (server-side only)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Webhook signing secret (server-side only)
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Rate limiting and file upload security
UPLOAD_LIMIT_MB=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Payment provider credentials are optional until the corresponding merchant
# integrations are activated. Store real values in Vercel server-side environment variables.
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=

CBE_CLIENT_ID=
CBE_CLIENT_SECRET=
CBE_MERCHANT_CODE=

BOA_MERCHANT_ID=
BOA_API_KEY=

DASHEN_MERCHANT_KEY=
DASHEN_SHORT_CODE=

AWASH_API_KEY=
AWASH_MERCHANT_ID=

CBE_BIRR_API_KEY=

# Admin secret (server-side only; never expose in VITE_* variables or GitHub)
ADMIN_PASSWORD=replace-with-a-unique-admin-password
