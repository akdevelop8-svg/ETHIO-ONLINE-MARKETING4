# ====================================================================
# ETHIO ONLINE MARKET (EOM) - VERCEL + SUPABASE ENVIRONMENT CONFIGURATION
# ====================================================================

# Local development only; Vercel manages the production runtime.
PORT=3000
NODE_ENV=production
APP_URL=https://your-vercel-domain.example
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REQUIRE_POSTGRES=true

# Copy the exact Supabase PostgreSQL Transaction Pooler URI from Supabase > Connect.
# Transaction Pooler commonly uses port 6543. URL-encode special characters in the password.
# Keep this server-side in Vercel; never prefix it with VITE_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# The frontend and API share the same Vercel origin. Leave VITE_API_BASE_URL unset.
# CORS_ORIGIN is optional and only needed if intentionally allowing a separate trusted client.
CORS_ORIGIN=

# AI assistant settings (server-side only; optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Webhook signing secret (server-side only)
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Rate limiting and file upload security
UPLOAD_LIMIT_MB=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Payment provider credentials are optional until the corresponding integrations are activated.
# Store real values only in Vercel Environment Variables, never in GitHub.
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=

CBE_CLIENT_ID=
CBE_CLIENT_SECRET=
CBE_MERCHANT_CODE=

BOA_MERCHANT_ID=
BOA_API_KEY=

DASHEN_MERCHANT_KEY=
DASHEN_SHORT_CODE=

AWASH_API_KEY=
AWASH_MERCHANT_ID=

CBE_BIRR_API_KEY=

# Admin secret (server-side only; never expose in VITE_* variables or GitHub)
ADMIN_PASSWORD=replace-with-a-unique-admin-password
